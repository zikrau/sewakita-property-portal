# ================================
# SewaKita environment variables
# ================================
# Supabase public URL, e.g. https://abcd.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Current Supabase publishable client key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secret. NEVER put this in frontend code or GitHub.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public site URL used for SEO/sitemap/OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional admin WhatsApp used only for future support/contact sections.
NEXT_PUBLIC_ADMIN_WHATSAPP=628xxxxxxxxxx
